# ───────────────────────────────────────────────
# AI Resume Screening System — Environment Config
# Copy this file:  cp .env.example .env
#   - Docker:     docker compose up --build   (hosts are overridden in docker-compose.yml)
#   - No Docker:  see "Local quick start" in README.md (backend/.env)
# ───────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_pass
POSTGRES_DB=resume_screening
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional full override (wins over POSTGRES_*), e.g. for running without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── Redis (Celery broker) ───────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── File storage ────────────────────────────────
# minio (S3 compatible) or local (files under LOCAL_STORAGE_DIR)
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=resumes

# ── Pipeline ────────────────────────────────────
# celery (needs Redis + worker) or inline (background tasks inside the API process)
PIPELINE_MODE=celery

# ── App ─────────────────────────────────────────
APP_NAME=AI Resume Screening System
APP_ENV=development
DEBUG=false
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── AI engine ───────────────────────────────────
# gemini (free key: https://aistudio.google.com/apikey) or heuristic (offline, no key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Fall back to the offline extractor/scorer when Gemini is missing or fails
LLM_FALLBACK_TO_HEURISTIC=true
SCORE_WEIGHT_RULE=0.4
SCORE_WEIGHT_SEMANTIC=0.2
SCORE_WEIGHT_LLM=0.4

# ── Frontend (build arg for docker compose) ─────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
